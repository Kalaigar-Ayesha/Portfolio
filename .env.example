# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# K. Ayesha Portfolio & Client Acquisition Platform
# ==============================================================================

# Base URL for canonical tags, Open Graph meta images, and XML sitemaps
# Development: http://localhost:3000
# Production: https://ayesha-devops.vercel.app or your custom domain (e.g. https://ayeshak.dev)
NEXT_PUBLIC_SITE_URL=https://ayesha-devops.vercel.app

# Analytics & Observability (Optional)
# Leave blank for privacy-conscious built-in zero-cookie event tracking
NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Contact Form Webhook / Email Service (Optional future expansion)
# If using Resend, SendGrid, or AWS SES for instant email dispatch:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# CONTACT_FORWARD_EMAIL=kalaigarayesha@gmail.com
